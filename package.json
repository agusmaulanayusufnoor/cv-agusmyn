{
  "name": "cv-agus-maulana",
  "scripts": {
    "build:pdf": "bun scripts/build-pdf.ts",
    "optimize:images": "bun scripts/optimize-images.ts",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/style.css --minify && bun scripts/bundle-css.ts",
    "build": "bun run build:css && bun run optimize:images && bun run build:pdf",
    "dev": "bun run --hot src/index.tsx",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.163.0"
  }
}
